rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedPlayer() { return request.auth != null && request.auth.token.get('firebase',{}).get('sign_in_provider','custom') != 'anonymous'; }
  function owner(uid) { return signedPlayer() && request.auth.uid == uid; }
  function today() { return int((request.time.toMillis()+28800000) / 86400000); }
  function seasonNow() { let t=request.time+duration.value(8,'h'); return string(t.year())+'-'+(t.month()<10?'0':'')+string(t.month()); }
  function player(uid) { return /databases/$(database)/documents/hkm_players/$(uid); }
  function run(uid,day) { let id=string(day); return /databases/$(database)/documents/hkm_players/$(uid)/runs/$(id); }
  function result(uid,day) { let id=uid+'_'+string(day); return /databases/$(database)/documents/hkm_results/$(id); }
  function rank(uid) { return /databases/$(database)/documents/hkm_rankings/$(uid); }
  function season(uid,s) { let id=uid+'_'+s; return /databases/$(database)/documents/hkm_seasons/$(id); }
  // Evaluate one tier only; packed answer strings keep large pools below the expression budget.
  function question(day,index) {
   let tier=int(index / 5);
   let slot=tier == 0 ? (day*17+(index%5)*7+0)%324 : tier == 1 ? (day*17+(index%5)*7+11)%426 : (day*17+(index%5)*7+22)%261;
   let ids=tier == 0 ? ["e01","e02","e03","e04","e05","e06","e07","e08","e09","e10","e11","e12","e13","e14","e15","e16","e17","e18","e19","e20","e21","e22","e23","e24","e25","e26","e27","e28","e29","e30","u04","u05","u08","u11","u14","c01","c03","c04","c08","c09","c10","c12","c18","c19","c34","c41","c45","c46","c48","c51","c60","c61","c62","c66","d05","d10","d12","d15","d17","d18","d21","d26","d27","d35","d38","d41","d43","d44","d45","d53","d54","d56","d59","s02","s05","s06","s09","s14","s24","s25","s26","s30","s43","s45","l01","l02","l03","l04","l11","l12","l13","l14","l21","l22","l23","l31","l32","l33","l41","l42","l43","l51","l52","l53","n01","n02","n03","n05","n10","n11","n12","n19","n21","n22","n31","n32","n33","n34","n41","n42","n43","n51","n52","n53","v02","v03","v04","v06","v11","v12","v17","v21","v24","v26","v41","v48","v49","v54","v55","v56","v57","v58","v59","v60","f01","f02","f03","f04","f05","f06","f07","f08","f09","f10","f11","f12","f13","f14","f15","f16","f17","f18","f19","f20","k01","k02","k03","k04","k05","k06","k07","k08","k09","k10","k11","k12","k13","k14","k15","k16","k17","k18","k19","k20","t01","t02","t03","t04","t05","t06","t07","t08","t09","t10","t11","t12","t13","t14","t15","t16","t17","t18","t19","t20","p01","p02","p03","p04","p05","p06","p07","p08","p09","p10","p11","p12","p13","p14","q01","q02","q03","q04","q05","q06","q07","q08","q09","q10","q11","q12","q13","r01","r02","r03","r04","r05","r06","r07","r08","r09","r10","r11","r12","r13","aa01","aa02","aa03","aa04","aa05","aa06","aa07","aa08","aa09","aa10","aa11","aa12","aa13","aa14","aa15","aa16","aa17","aa18","aa19","aa20","aa21","aa22","aa23","aa24","aa25","aa26","aa27","aa28","aa29","aa30","aa31","aa32","aa33","aa34","aa35","aa36","aa37","aa38","aa39","aa40","dd01","dd02","dd03","dd04","dd05","dd06","dd07","dd08","dd09","dd10","dd11","dd12","dd13","dd14","dd15","dd16","dd17","dd18","dd19","dd20","dd21","dd22","dd23","dd24","dd25","dd26","dd27","dd28","dd29","dd30","dd31","dd32","dd33","dd34","dd35","dd36","dd37","dd38","dd39","dd40"] : tier == 1 ? ["m01","m02","m03","m04","m05","m06","m07","m08","m09","m10","m11","m12","m13","m14","m15","m16","m17","m18","m19","m20","m21","m22","m23","m24","m25","m26","m27","m28","m29","m30","h01","h02","h03","h04","h10","h12","h13","h15","h17","h18","h23","h24","h25","h29","h30","u02","u03","u06","u07","u09","u12","u13","c02","c05","c07","c11","c13","c14","c16","c17","c20","c22","c23","c24","c26","c28","c31","c33","c35","c37","c38","c42","c43","c47","c49","c50","c52","c53","c54","c56","c57","c58","c59","c63","c64","c67","d01","d02","d03","d04","d08","d09","d11","d13","d14","d16","d19","d22","d23","d24","d25","d28","d29","d30","d31","d32","d33","d34","d36","d37","d39","d40","d42","d47","d48","d49","d50","d51","d52","d55","d57","d60","s01","s03","s04","s07","s08","s10","s11","s12","s13","s15","s16","s17","s18","s19","s20","s21","s22","s23","s27","s28","s29","s31","s32","s33","s34","s35","s37","s38","s39","s40","s41","s42","s44","s46","s47","s48","s49","s50","s51","s52","s53","s55","s56","s57","s58","s59","s60","l05","l06","l07","l08","l09","l15","l16","l17","l18","l19","l20","l24","l25","l26","l28","l29","l30","l34","l35","l36","l37","l38","l39","l40","l44","l45","l46","l47","l48","l49","l50","l54","l55","l56","l57","l59","l60","n04","n06","n09","n13","n14","n18","n23","n24","n25","n35","n36","n37","n38","n44","n45","n46","n47","n54","n55","n56","v01","v05","v07","v08","v09","v13","v14","v15","v16","v20","v28","v31","v32","v33","v34","v40","v46","v47","v50","v53","f21","f22","f23","f24","f25","f26","f27","f28","f29","f30","f31","f32","f33","f34","f35","f36","f37","f38","f39","f40","k21","k22","k23","k24","k25","k26","k27","k28","k29","k30","k31","k32","k33","k35","k36","k37","k38","k39","k40","k51","t21","t22","t23","t24","t25","t26","t27","t28","t29","t30","t31","t32","t33","t34","t35","t36","t37","t38","t39","t40","p15","p16","p17","p18","p19","p20","p21","p22","p23","p24","p25","p26","p27","q14","q15","q16","q17