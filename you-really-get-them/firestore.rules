rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validDimension(dimension) {
      return dimension is map
        && dimension.keys().hasAll(['name', 'score'])
        && dimension.keys().hasOnly(['name', 'score'])
        && dimension.name is string
        && dimension.name.size() <= 20
        && dimension.score is int
        && dimension.score >= 0
        && dimension.score <= 100;
    }

    function validDimensions(dimensions) {
      return dimensions is list
        && dimensions.size() == 5
        && validDimension(dimensions[0])
        && validDimension(dimensions[1])
        && validDimension(dimensions[2])
        && validDimension(dimensions[3])
        && validDimension(dimensions[4]);
    }

    function validProfileMetadata(data) {
      return data.keys().hasAll(['displayName', 'photoURL', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() <= 50
        && (!('playerName' in data)
          || (data.playerName is string && data.playerName.size() <= 20))
        && (!('favoriteCards' in data)
          || (data.favoriteCards is list && data.favoriteCards.size() <= 200))
        && (!('playerNameUpdatedAt' in data) || data.playerNameUpdatedAt is timestamp)
        && data.photoURL is string
        && data.photoURL.size() <= 2048
        && data.updatedAt is timestamp;
    }

    function validRunResult(data) {
      return data is map
        && data.keys().hasAll(['hp', 'correct', 'survived', 'submittedAt'])
        && data.keys().hasOnly(['hp', 'correct', 'survived', 'submittedAt'])
        && data.hp is int
        && data.hp >= 0
        && data.hp <= 100
        && data.correct is int
        && data.correct >= 0
        && data.correct <= 12
        && data.survived is bool
        && data.submittedAt is int;
    }

    function validLeaderboard(data, uid, faction) {
      return data.keys().hasAll([
          'uid', 'faction', 'displayName', 'bestHp', 'bestCorrect', 'runs', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'faction', 'displayName', 'bestHp', 'bestCorrect', 'runs', 'updatedAt'
        ])
        && data.uid == uid
        && data.faction == faction
        && faction in ['women', 'men', 'dog', 'cat', 'duo']
        && data.displayName is string
        && data.displayName.size() <= 50
        && data.bestHp is int
        && data.bestHp >= 0
        && data.bestHp <= 100
        && data.bestCorrect is int
        && data.bestCorrect >= 0
        && data.bestCorrect <= 12
        && data.runs is int
        && data.runs >= 1
        && data.updatedAt is timestamp;
    }

    function validPlayerNameUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['playerName'])
        ? request.resource.data.playerNameUpdatedAt == request.time
          && (!('playerNameUpdatedAt' in resource.data)
            || resource.data.playerNameUpdatedAt <= request.time - duration.value(90, 'd'))
        : request.resource.data.get('playerNameUpdatedAt', null)
          == resource.data.get('playerNameUpdatedAt', null);
    }


    // SC lives in an account-only transactional wallet; profile coin fields remain forbidden.
    function walletOwner(uid) {
      return signedIn() && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function cardIds() { return ['w_1','w_2','w_3','m_1','m_2','m_3','d_1','d_2','d_3','c_1','c_2','c_3','w_4','m_4','d_4','c_4','w_5','m_5','d_5','c_5','w_6','m_6','d_6','c_6','w_7','m_7','d_7','c_7','d_8','d_9','d_10','d_11','d_12','d_13','d_14','d_15','c_8','c_9','c_10','c_11','c_12','c_13','c_14','c_15','w_8','w_9','w_10','w_11','m_8','m_9','m_10','m_11','d_16','d_17','d_18','d_19','c_16','c_17','c_18','c_19','w_12','w_13','w_14','w_15','m_12','m_13','m_14','m_15','d_20','d_21','d_22','d_23','c_20','c_21','c_22','c_23','w_16','w_17','w_18','w_19','m_16','m_17','m_18','m_19','d_24','d_25','d_26','d_27','c_24','c_25','c_26','c_27','w_20','w_21','m_20','m_21','d_28','d_29','c_28','c_29','w_22','w_23','w_24','w_25','m_22','m_23','m_24','m_25','d_30','d_31','d_32','d_33','c_30','c_31','c_32','c_33','w_26','w_27','w_28','w_29','m_26','m_27','m_28','m_29','d_34','d_35','d_36','d_37','c_34','c_35','c_36','c_37','w_30','w_31','w_32','w_33','m_30','m_31','m_32','m_33','d_38','d_39','d_40','d_41','c_38','c_39','c_40','c_41','w_34','w_35','w_36','w_37','m_34','m_35','m_36','m_37','d_42','d_43','d_44','d_45','c_42','c_43','c_44','c_45','w_38','w_39','w_40','w_41','m_38','m_39','m_40','m_41','d_46','d_47','d_48','d_49','c_46','c_47','c_48','c_49']; }
    function bonusCardIds() { return ['m_3','d_3','c_1','w_4','c_4','m_6','d_6','m_7','d_10','d_13','d_15','c_11','c_12','c_15','m_8','d_16','d_17','d_19','c_19','w_13','m_13','m_15','d_21','c_21','w_17','w_19','m_19','d_26','c_24','m_20','d_29','c_28','w_22','w_23','m_23','d_32','c_31','c_33','w_27','m_27','d_35','c_35','c_37','w_32','m_32','d_40','c_40','w_35','m_36','d_42','d_45','c_43','w_38','w_41','m_39','d_48','c_47']; }
    function cardName(id) { return {'w_1':'傲嬌雙馬尾','w_2':'名偵探女友','w_3':'白月光天使','m_1':'鋼鐵直男','m_2':'電競肝帝','m_3':'傳說霸總','d_1':'短腿柯基','d_2':'拆家哈士奇','d_3':'倔強柴將軍','c_1':'十橘九胖','c_2':'虛空黑貓','c_3':'仙氣布偶皇','w_4':'珍奶續命員','m_4':'電車瞓覺王','d_4':'空碗控訴犬','c_4':'紙箱業主','w_5':'餐牌選擇困難','m_5':'樹枝見習勇者','d_5':'散步手掣犬','c_5':'鍵盤監工','w_6':'雨天搬運隊長','m_6':'開樽蓋英雄','d_6':'拖鞋尋寶員','c_6':'水杯測試官','w_7':'零食案情分析師','m_7':'鑊氣料理大師','d_7':'星際柯基司令','c_7':'沙發宇宙皇帝','d_8':'博美保安隊長','d_9':'比格聞案專員','d_10':'金毛迎賓主任','d_11':'臘腸梳化長租客','d_12':'邊牧戰術教練','d_13':'貴婦紙巾造型師','d_14':'薩摩耶雲端艦長','d_15':'斑點消防超人','c_8':'英短包裹驗收官','c_9':'暹羅深夜主唱','c_10':'美短鍵盤總監','c_11':'異短梳化抱枕','c_12':'緬因城堡領主','c_13':'孟加拉紙箱探險家','c_14':'挪威森林守護者','c_15':'斯芬克斯太陽王','w_8':'毛毯充電員','w_9':'雨夜掃街達人','w_10':'行程控場總監','w_11':'休息結界女王','m_8':'最後薯條守衛','m_9':'傢俬組裝勇者','m_10':'公園大導演','m_11':'星際補眠法師','d_16':'雪納瑞試味總編','d_17':'西施沙龍紅星','d_18':'阿富汗秀髮巨星','d_19':'聖伯納雪山救援王','c_16':'俄藍廚房門神','c_17':'阿比書架巡察員','c_18':'德文星艦通訊官','c_19':'安哥拉月宮館長','w_12':'充電線拆彈員','w_13':'夜市小食平衡師','w_14':'排隊路線軍師','w_15':'拿鐵預言女神','m_12':'巴士夢醒旅人','m_13':'野餐補給官','m_14':'反骨雨傘工程師','m_15':'電競宵夜大帝','d_20':'惠比特毛毯可頌','d_21':'瑪爾濟斯泡泡雲','d_22':'伯恩山列車長','d_23':'秋田紅葉守衛','c_20':'土耳其梵水務探員','c_21':'伯曼包裹派送員','c_22':'索馬利解謎教授','c_23':'西伯利亞星夜車長','w_16':'升降機耐性專員','w_17':'雨中花束保全','w_18':'拼圖收尾偵探','w_19':'天台花園魔導士','m_16':'洗衣塔管理員','m_17':'牛油果鑑定師','m_18':'微型單位建築師','m_19':'米餅馴龍王','d_24':'波士頓洗衣保安','d_25':'蝴蝶犬迎風司儀','d_26':'紐芬蘭浴池救生員','d_27':'靈緹銀河速遞','c_24':'雪鞋襪子扣留官','c_25':'孟買燈下影帝','c_26':'埃及貓地圖探險家','c_27':'巴厘月光舞王','w_20':'霓虹夜巷探店員','w_21':'早餐光速女俠','m_20':'洗碗泡泡武士','m_21':'客廳露營宇宙王','d_28':'喜樂蒂街角導遊','d_29':'大白熊雪雲守門員','c_28':'玩具虎紙箱王子','c_29':'新加坡星光導航員','w_22':'零錢考古專員','w_23':'海風票尾守衛','w_24':'轉乘路線策劃師','w_25':'星夜月台守護者','m_22':'衣架解結員','m_23':'街角栗子嚮導','m_24':'相機電池補給官','m_25':'星圖模型製造師','d_30':'日本尖嘴拖鞋巡官','d_31':'葡水花園見習生','d_32':'古牧洗衣列車長','d_33':'藏獒金雲守門將','c_30':'捲耳鉛筆鑑定員','c_31':'英長茶墊領主','c_32':'東短音控總監','c_33':'襤褸貓銀河郵差','w_26':'鬧鐘談判員','w_27':'宵夜護送員','w_28':'飯煲鑑證官','w_29':'棉被月宮女皇','m_26':'孤襪配對員','m_27':'買餸補給隊長','m_28':'戲票守門員','m_29':'遙控器宇宙騎士','d_34':'巴仙吉門鐘旁聽員','d_35':'巴吉度野餐巡官','d_36':'牛頭㹴洗衣督察','d_37':'愛爾蘭獵狼星園守衛','c_34':'科拉特紙箱審計員','c_35':'哈瓦那紙袋掌櫃','c_36':'塞爾凱克暖衣總管','c_37':'涅瓦假面棉被星君','w_30':'交通卡餘額巡查員','w_31':'早餐防灑員','w_32':'雨傘撤退策劃師','w_33':'截圖宇宙存檔官','m_30':'外賣袋考古員','m_31':'月台走位教練','m_32':'週末煎蛋指揮官','m_33':'客廳露營星際領隊','d_38':'北京犬地氈領班','d_39':'西高地白㹴雨靴巡更','d_40':'澳洲牧羊犬野餐統籌','d_41':'蘇格蘭獵鹿犬月台星將','c_38':'曼島貓鍵盤代班','c_39':'沙特爾藍貓木箱掌櫃','c_40':'美國剛毛貓洗衣籃會長','c_41':'拉邦捲毛貓彗星旅人','w_34':'保鮮盒尋蓋員','w_35':'手信分配協調員','w_36':'家務輪班策劃師','w_37':'週末星圖守時官','m_34':'電線收納實習生','m_35':'公園長櫈導航員','m_36':'火鍋漏勺救援員','m_37':'零件宇宙外交官','d_42':'阿拉斯加放工雪橇員','d_43':'羅威納快遞旁聽員','d_44':'紅白雪達野餐偵察員','d_45':'大丹犬梳化星航員','c_42':'美國短尾貓襪子藏寶員','c_43':'緬甸貓窗台咖啡師','c_44':'歐西貓盆栽監察員','c_45':'澳洲霧貓陽台星霧館長','w_38':'散紙分流員','w_39':'衣櫃天氣預報員','w_40':'客廳遙距導演','w_41':'零食星球保管官','m_38':'膠袋摺疊學徒','m_39':'冰箱便條傳令員','m_40':'星期八鬧鐘法官','m_41':'手電筒銀河巡夜員','d_46':'沙皮犬毛巾旁聽員','d_47':'凱利藍㹴雨傘巡更','d_48':'新斯科舍玩具鴨專員','d_49':'特伏丹星夜巡邏長','c_46':'布米拉襪籃合議員','c_47':'科尼斯捲毛毛毯編輯','c_48':'托金斯枕頭調解員','c_49':'烏拉爾捲毛星霧法官'}[id]; }
    function validWallet(data) {
      return data.keys().hasAll(['coins','revision','lastOperation','bonds','contracts','updatedAt'])
        && data.keys().hasOnly(['coins','revision','lastOperation','bonds','contracts','updatedAt'])
        && data.coins is int && data.coins >= 0 && data.coins <= 1000000000
        && data.revision is int && data.revision >= 0
        && data.lastOperation is string
        // Creation requires empty bonds; validProgress permits only the verified companion key.
        && data.bonds is map
        && data.contracts is list && data.contracts.size() <= 4
        && data.contracts.toSet().size() == data.contracts.size()
        && data.contracts.hasOnly(['on_time','no_hint','solo','healthy'])
        && data.updatedAt == request.time;
    }
    function contractMet(op) {
      return op.completed == 12 && (
        (op.contractId == 'on_time' && op.timeouts == 0)
        || (op.contractId == 'no_hint' && op.hintsUsed == 0)
        || (op.contractId == 'solo' && op.skillUsed == false)
        || (op.contractId == 'healthy' && op.hp >= 30)
      );
    }
    function validRewardOp(op) {
      return op.keys().hasAll(['kind','delta','revision','hp','completed','companionId','contractId','contractEarned','timeouts','hintsUsed','skillUsed','ranked','createdAt'])
        && op.keys().hasOnly(['kind','delta','revision','hp','completed','companionId','contractId','contractEarned','timeouts','hintsUsed','skillUsed','ranked','createdAt'])
        && op.kind == 'run' && op.revision is int
        && op.hp is int && op.hp >= 0 && op.hp <= 100
        && op.completed is int && op.completed >= 1 && op.completed <= 12
        && (op.completed == 12 || op.hp == 0)
        && op.companionId is string && (op.companionId == '' || op.companionId in cardIds())
        && op.timeouts is int && op.timeouts >= 0 && op.timeouts <= op.completed
        && op.hintsUsed is int && op.hintsUsed >= 0 && op.hintsUsed <= 2
        && op.skillUsed is bool && op.ranked is bool
        && (!op.skillUsed || (op.companionId != '' && !(op.companionId in bonusCardIds())))
        && op.ranked == !op.skillUsed
        && op.contractId in ['none','on_time','no_hint','solo','healthy']
        && op.contractEarned is bool && op.contractEarned == contractMet(op)
        && op.delta is int && op.delta == (op.hp > 0
          ? 100 + op.hp * 2 + (op.companionId in bonusCardIds() ? 20 : 0) : 10)
        && op.createdAt == request.time;
    }
    function validDrawOp(uid, op) {
      let before = get(/databases/$(database)/documents/users/$(uid)).data.get('favoriteCards', []);
      let after = getAfter(/databases/$(database)/documents/users/$(uid)).data.get('favoriteCards', []);
      return op.keys().hasAll(['kind','delta','revision','cardId','cardName','duplicate','createdAt'])
        && op.keys().hasOnly(['kind','delta','revision','cardId','cardName','duplicate','createdAt'])
        && op.kind == 'draw' && op.revision is int && op.cardId in cardIds()
        && op.cardName == cardName(op.cardId)
        && op.duplicate is bool && op.duplicate == before.hasAny([op.cardId, op.cardName])
        && op.delta is int && op.delta == (op.duplicate ? -75 : -100)
        && (op.duplicate ? after == before : (
          after.size() == before.size() + 1
          && after.hasAll(before) && after.hasAny([op.cardId])
          && after.toSet().difference(before.toSet()).hasOnly([op.cardId])
        )) && op.createdAt == request.time;
    }
    function validRunReceipt(uid, id, op) {
      let run = getAfter(/databases/$(database)/documents/users/$(uid)/runs/$(id)).data;
      return !exists(/databases/$(database)/documents/users/$(uid)/runs/$(id))
        && run.hp == op.hp && run.coins == op.delta
        && run.correct <= op.completed && run.survived == (op.hp > 0)
        && run.createdAt == request.time;
    }
    function validProgress(before, after, op) {
      return (op.completed == 12 && op.companionId != '' ? (
          after.bonds.diff(before.bonds).affectedKeys().hasOnly([op.companionId])
          && after.bonds.get(op.companionId, 0) is int
          && after.bonds.get(op.companionId, 0) == before.bonds.get(op.companionId, 0) + 1
          && after.bonds.get(op.companionId, 0) <= 1000000000
        ) : after.bonds == before.bonds)
        && (op.contractEarned ? (
          after.contracts.hasAll(before.contracts)
          && after.contracts.hasAny([op.contractId])
          && after.contracts.size() == before.contracts.size() + (op.contractId in before.contracts ? 0 : 1)
          && after.contracts.toSet().difference(before.contracts.toSet()).hasOnly([op.contractId])
        ) : after.contracts == before.contracts);
    }
    function validWalletTransition(uid, id, before, after, op) {
      return id.matches('^(run|draw)_[A-Za-z0-9_-]{8,70}$')
        && !exists(/databases/$(database)/documents/users/$(uid)/walletOps/$(id))
        && validWallet(after) && after.revision == before.revision + 1
        && after.lastOperation == id && op.revision == after.revision
        && after.coins == before.coins + op.delta
        && (op.kind == 'run'
          ? validRewardOp(op) && validRunReceipt(uid, id, op) && validProgress(before, after, op)
            && (op.companionId == '' || get(/databases/$(database)/documents/users/$(uid)).data
              .get('favoriteCards', []).hasAny([op.companionId]))
          : op.kind == 'draw' && before.coins >= 100 && validDrawOp(uid, op)
            && after.bonds == before.bonds && after.contracts == before.contracts);
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      // New profiles contain metadata only. Legacy asset fields may remain on
      // old documents, but clients cannot add, change, or delete them.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'playerName', 'playerNameUpdatedAt', 'favoriteCards', 'photoURL', 'updatedAt'])
        && validProfileMetadata(request.resource.data)
        && (!('playerName' in request.resource.data)
          || request.resource.data.playerName == ''
          || request.resource.data.get('playerNameUpdatedAt', null) == request.time);

      allow update: if signedIn()
        && request.auth.uid == uid
        && validProfileMetadata(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'playerName', 'playerNameUpdatedAt', 'favoriteCards', 'photoURL', 'updatedAt'])
        && validPlayerNameUpdate();
      allow delete: if false;


      match /wallet/main {
        allow read: if walletOwner(uid);
        allow create: if walletOwner(uid) && validWallet(request.resource.data)
          && request.resource.data.coins == 0 && request.resource.data.revision == 0
          && request.resource.data.lastOperation == ''
          && request.resource.data.bonds == {} && request.resource.data.contracts == [];
        allow update: if walletOwner(uid)
          && validWalletTransition(uid, request.resource.data.lastOperation, resource.data,
            request.resource.data, getAfter(/databases/$(database)/documents/users/$(uid)/walletOps/$(request.resource.data.lastOperation)).data);
        allow delete: if false;
      }
      match /walletOps/{operationId} {
        allow read: if walletOwner(uid);
        allow create: if walletOwner(uid)
          && exists(/databases/$(database)/documents/users/$(uid)/wallet/main)
          && validWalletTransition(uid, operationId,
            get(/databases/$(database)/documents/users/$(uid)/wallet/main).data,
            getAfter(/databases/$(database)/documents/users/$(uid)/wallet/main).data,
            request.resource.data);
        allow update, delete: if false;
      }

      match /runs/{runId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll([
            'faction', 'mode', 'questionCount', 'dimensions', 'survived',
            'hp', 'coins', 'correct', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'faction', 'mode', 'questionCount', 'dimensions', 'survived',
            'hp', 'coins', 'correct', 'createdAt'
          ])
          && request.resource.data.faction in ['women', 'men', 'dog', 'cat', 'duo']
          && request.resource.data.mode == 'mixed'
          && request.resource.data.questionCount == 12
          && (request.resource.data.dimensions == null
            || validDimensions(request.resource.data.dimensions))
          && request.resource.data.survived is bool
          && request.resource.data.hp is int
          && request.resource.data.hp >= 0
          && request.resource.data.hp <= 100
          && request.resource.data.coins is int
          && request.resource.data.coins >= 0
          && request.resource.data.correct is int
          && request.resource.data.correct >= 0
          && request.resource.data.correct <= 12
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if signedIn()
        && validLeaderboard(request.resource.data, request.auth.uid, request.resource.data.faction)
        && entryId == request.auth.uid + '_' + request.resource.data.faction
        && request.resource.data.runs == 1;
      allow update: if signedIn()
        && validLeaderboard(request.resource.data, request.auth.uid, request.resource.data.faction)
        && entryId == request.auth.uid + '_' + request.resource.data.faction
        && resource.data.uid == request.auth.uid
        && resource.data.faction == request.resource.data.faction
        && request.resource.data.runs == resource.data.runs + 1
        && request.resource.data.bestHp >= resource.data.bestHp
        && (request.resource.data.bestHp > resource.data.bestHp
          || request.resource.data.bestCorrect >= resource.data.bestCorrect);
      allow delete: if false;
    }

    match /challenges/{challengeId} {
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid
        || resource.data.get('guestUid', null) == request.auth.uid
        || resource.data.status == 'waiting'
      );

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'ownerUid', 'ownerName', 'faction', 'seed', 'status', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'ownerName', 'faction', 'seed', 'status', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 50
        && request.resource.data.faction in ['women', 'men', 'dog', 'cat', 'duo']
        && request.resource.data.seed is int
        && request.resource.data.status == 'waiting'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt > request.time.toMillis();

      allow update: if signedIn() && (
        (
          resource.data.status == 'waiting'
          && resource.data.get('guestUid', null) == null
          && resource.data.ownerUid != request.auth.uid
          && resource.data.expiresAt > request.time.toMillis()
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() <= 50
          && request.resource.data.status == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['guestUid', 'guestName', 'status'])
        )
        ||
        (
          resource.data.ownerUid == request.auth.uid
          && resource.data.get('ownerResult', null) == null
          && validRunResult(request.resource.data.ownerResult)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ownerResult', 'status'])
          && request.resource.data.status == (
            resource.data.get('guestResult', null) != null
              ? 'completed'
              : resource.data.status
          )
        )
        ||
        (
          resource.data.get('guestUid', null) == request.auth.uid
          && resource.data.get('guestResult', null) == null
          && validRunResult(request.resource.data.guestResult)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['guestResult', 'status'])
          && request.resource.data.status == (
            resource.data.get('ownerResult', null) != null
              ? 'completed'
              : resource.data.status
          )
        )
      );
      allow delete: if false;
    }
  }
}
