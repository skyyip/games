rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function player(uid) { return /databases/$(database)/documents/frogger_players/$(uid); }
  function run(uid,id) { return /databases/$(database)/documents/frogger_players/$(uid)/runs/$(id); }
  function species(id) { return id in ["frog","penguin","bunny","monkey","otter","duck","cat","panda","fox","capybara","mochi","chiikawa","hachiware","usagi","kurimanju","rakko","momonga","shisa","shimajiro","mermaid","hitoha","futaba","elf-mage","violet-mage","red-warrior","red-sprout","blue-sprout","yellow-sprout","black-sprout","pink-sprout","white-sprout","purple-sprout","ice-sprout","bloom-bunny","mage-otter","dawn-hero","stone-dwarf","gentle-priest"]; }
  function price(id) { return {"frog":0,"penguin":120,"bunny":140,"monkey":180,"otter":160,"duck":180,"cat":200,"panda":240,"fox":480,"capybara":320,"mochi":520,"chiikawa":680,"hachiware":720,"usagi":760,"kurimanju":800,"rakko":1200,"momonga":840,"shisa":880,"shimajiro":920,"mermaid":960,"hitoha":1000,"futaba":1040,"elf-mage":1120,"violet-mage":1160,"red-warrior":1200,"red-sprout":220,"blue-sprout":260,"yellow-sprout":280,"black-sprout":300,"pink-sprout":340,"white-sprout":360,"purple-sprout":400,"ice-sprout":440,"bloom-bunny":1280,"mage-otter":1360,"dawn-hero":1440,"stone-dwarf":1520,"gentle-priest":1600}[id]; }
  function coins(score) { return 1 + score * 2 + int(score / 20) * 10; }
  function valid(p) {
   return validGear(p) && p.keys().hasOnly(['version','name','nameKey','coins','owned','selected','best','bestAnimal','bestAt','createdAt','updatedAt','activeRun','lastSettledRun','ownedSkills','equippedSkill','ownedCompanions','companion'])
    && p.version == 2 && p.name is string && p.name.matches('^[A-Za-z0-9_\\-一-鿿㐀-䶿]{2,16}$') && p.nameKey == p.name.lower()
    && p.coins is int && p.coins >= 0 && p.coins <= 2000005000
    && p.owned is list && p.owned.size() >= 1 && p.owned.size() <= 38 && p.owned.toSet().size() == p.owned.size()
    && p.owned.hasAll(['frog']) && p.owned.hasOnly(["frog","penguin","bunny","monkey","otter","duck","cat","panda","fox","capybara","mochi","chiikawa","hachiware","usagi","kurimanju","rakko","momonga","shisa","shimajiro","mermaid","hitoha","futaba","elf-mage","violet-mage","red-warrior","red-sprout","blue-sprout","yellow-sprout","black-sprout","pink-sprout","white-sprout","purple-sprout","ice-sprout","bloom-bunny","mage-otter","dawn-hero","stone-dwarf","gentle-priest"]) && p.selected in p.owned
    && p.best is int && p.best >= 0 && p.best <= 1000000 && p.bestAnimal in p.owned
    && p.bestAt is timestamp && p.createdAt is timestamp && p.updatedAt == request.time
    && (p.activeRun == null || p.activeRun is string) && (p.lastSettledRun == null || p.lastSettledRun is string);
  }
  function validGear(p) {
   let skills=p.get('ownedSkills',[]); let friends=p.get('ownedCompanions',[]);
   return skills is list && skills.size() <= 6 && skills.toSet().size() == skills.size() && skills.hasOnly(["double","adjust","prune","anchor","shield","rescue"])
    && friends is list && friends.size() <= 6 && friends.toSet().size() == friends.size() && friends.hasOnly(["hippo","ray","crab","beaver","koi","shark"])
    && (p.get('equippedSkill','') == '' || p.get('equippedSkill','') in skills) && (p.get('companion','') == '' || p.get('companion','') in friends);
  }
  function retiredCredit(old) {
   let skills=old.get('ownedSkills',[]);
   return (skills.hasAny(['double']) ? 640 : 0) + (skills.hasAny(['adjust']) ? 800 : 0) + (skills.hasAny(['prune']) ? 720 : 0) + (skills.hasAny(['anchor']) ? 880 : 0) + (skills.hasAny(['shield']) ? 960 : 0) + (skills.hasAny(['rescue']) ? 1000 : 0);
  }
  function retireSkills(p,old) {
   return old.get('ownedSkills',[]).size() > 0
    && p.diff(old).affectedKeys().hasOnly(['ownedSkills','equippedSkill','coins','updatedAt'])
    && p.get('ownedSkills',[]) == [] && p.get('equippedSkill','') == ''
    && p.coins == old.coins + retiredCredit(old);
  }
  function gearChange(p,old) {
   let friends=p.get('ownedCompanions',[]); let before=old.get('ownedCompanions',[]); let friend=p.get('companion','');
   return p.diff(old).affectedKeys().hasOnly(['ownedCompanions','companion','coins','updatedAt']) && (
    (friends == before && p.coins == old.coins)
    || (friends.size() == before.size()+1 && friends.hasAll(before) && !(friend in before) && p.coins == old.coins-{"hippo":540,"ray":360,"crab":200,"beaver":260,"koi":100,"shark":420}[friend])
   );
  }
  function selection(p,old) { return p.diff(old).affectedKeys().hasOnly(['selected','updatedAt']); }
  function purchase(p,old) { return p.diff(old).affectedKeys().hasOnly(['owned','selected','coins','updatedAt']) && p.owned.size() == old.owned.size()+1 && p.owned.hasAll(old.owned) && !(p.selected in old.owned) && p.coins == old.coins-price(p.selected); }
  function begin(p,old,uid) { return p.diff(old).affectedKeys().hasOnly(['activeRun','updatedAt']) && p.activeRun is string && p.activeRun != old.activeRun && getAfter(run(uid,p.activeRun)).data.status == 'playing' && getAfter(run(uid,p.activeRun)).data.startedAt == request.time && (old.activeRun == null || getAfter(run(uid,old.activeRun)).data.status == 'abandoned'); }
  function abandon(p,old,uid) { return p.diff(old).affectedKeys().hasOnly(['activeRun','updatedAt']) && p.activeRun == null && old.activeRun is string && getAfter(run(uid,old.activeRun)).data.status == 'abandoned'; }
  function finish(p,old,uid) {
   let r=getAfter(run(uid,old.activeRun)).data;
   return p.diff(old).affectedKeys().hasOnly(['coins','activeRun','lastSettledRun','best','bestAnimal','bestAt','updatedAt']) && p.activeRun == null && p.lastSettledRun == old.activeRun && old.activeRun is string && r.status == 'finished' && p.coins == old.coins+r.coinsEarned
    && (r.score > old.best ? p.best == r.score && p.bestAnimal == r.animal && p.bestAt == request.time : p.best == old.best && p.bestAnimal == old.bestAnimal && p.bestAt == old.bestAt);
  }
  match /frogger_names/{key} {
   allow get: if request.auth != null;
   allow list, update, delete: if false;
   allow create: if owner(request.resource.data.uid) && request.resource.data.keys().hasOnly(['uid','name']) && getAfter(player(request.auth.uid)).data.nameKey == key && getAfter(player(request.auth.uid)).data.name == request.resource.data.name;
  }
  match /frogger_players/{uid} {
   allow get: if owner(uid);
   allow list, delete: if false;
   allow create: if owner(uid) && valid(request.resource.data) && request.resource.data.coins == 0 && request.resource.data.get('ownedSkills',[]) == [] && request.resource.data.get('ownedCompanions',[]) == [] && request.resource.data.owned == ['frog'] && request.resource.data.selected == 'frog' && request.resource.data.best == 0 && request.resource.data.bestAnimal == 'frog' && request.resource.data.bestAt == request.time && request.resource.data.createdAt == request.time && request.resource.data.activeRun == null && request.resource.data.lastSettledRun == null && getAfter(/databases/$(database)/documents/frogger_names/$(request.resource.data.nameKey)).data.uid == uid;
   allow update: if owner(uid) && valid(request.resource.data) && request.resource.data.name == resource.data.name && request.resource.data.nameKey == resource.data.nameKey && request.resource.data.createdAt == resource.data.createdAt && (retireSkills(request.resource.data,resource.data) || gearChange(request.resource.data,resource.data) || selection(request.resource.data,resource.data) || purchase(request.resource.data,resource.data) || begin(request.resource.data,resource.data,uid) || abandon(request.resource.data,resource.data,uid) || finish(request.resource.data,resource.data,uid));
   match /runs/{id} {
    allow get: if owner(uid);
    allow list, delete: if false;
    allow create: if owner(uid) && request.resource.data.keys().hasOnly(['uid','animal','skill','companion','status','startedAt','endedAt','score','coinsEarned','bonusCoins']) && request.resource.data.uid == uid && species(request.resource.data.animal) && request.resource.data.animal == get(player(uid)).data.selected && request.resource.data.get('skill','') == get(player(uid)).data.get('equippedSkill','') && request.resource.data.get('companion','') == get(player(uid)).data.get('companion','') && request.resource.data.status == 'playing' && request.resource.data.startedAt == request.time && request.resource.data.endedAt == null && request.resource.data.score == 0 && request.resource.data.coinsEarned == 0 && request.resource.data.get('bonusCoins',0) == 0 && getAfter(player(uid)).data.activeRun == id;
    allow update: if owner(uid)
      && resource.data.status == 'playing'
      && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'endedAt', 'score', 'coinsEarned', 'bonusCoins'])
      && request.resource.data.endedAt == request.time
      && (
        (
          request.resource.data.status == 'abandoned'
          && request.resource.data.score == 0
          && request.resource.data.coinsEarned == 0
          && request.resource.data.get('bonusCoins',0) == 0
          && getAfter(player(uid)).data.activeRun != id
        )
        || (
          request.resource.data.status == 'finished'
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 1000000
          && request.time + duration.value(1000, 'ms')
            >= resource.data.startedAt
              + duration.value(request.resource.data.score * 250, 'ms')
          && request.resource.data.get('bonusCoins',0) is int
          && request.resource.data.get('bonusCoins',0) >= 0
          && request.resource.data.get('bonusCoins',0) <= request.resource.data.score * 3
          && request.resource.data.coinsEarned == coins(request.resource.data.score) + request.resource.data.get('bonusCoins',0)
          && getAfter(player(uid)).data.lastSettledRun == id
          && getAfter(player(uid)).data.activeRun == null
        )
      );
   }
  }
  match /frogger_leaderboard/{uid} {
   allow get: if true;
   // Signed-in players use an aggregate count for their rank outside the top ten.
   // This collection contains public scores only; private wallets remain owner-only.
   allow list: if request.auth != null || (request.query.limit != null && request.query.limit <= 10);
   allow delete: if false;
   allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['uid','name','score','animal','at']) && request.resource.data.uid == uid && request.resource.data.name == getAfter(player(uid)).data.name && request.resource.data.score == getAfter(player(uid)).data.best && request.resource.data.score > 0 && request.resource.data.animal == getAfter(player(uid)).data.bestAnimal && request.resource.data.at == getAfter(player(uid)).data.bestAt && request.resource.data.at == request.time;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
